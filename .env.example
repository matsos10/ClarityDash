# --- Base ---
DATABASE_URL=postgresql://palmela:change-me@db:5432/palmela
POSTGRES_PASSWORD=change-me
APP_URL=https://palmela.example.com
TZ_APP=Europe/Lisbon

# --- NextAuth ---
NEXTAUTH_URL=https://palmela.example.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seuls ces e-mails peuvent se connecter (séparés par des virgules)
MATIAS_EMAIL=matias@example.com
ANA_EMAIL=ana@example.com
# Connexion de dev sans Google (jamais en production)
DEV_LOGIN=0

# --- Push (npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:matias@example.com

# --- Fichiers (captures de trades) ---
UPLOAD_DIR=/data/uploads

# --- APK Android (TWA) ---
TWA_PACKAGE_NAME=pt.circulofacetado.basepalmela
# Empreintes SHA-256 du certificat de signature, séparées par des virgules
TWA_SHA256_FINGERPRINTS=

# --- IA (phase 4) ---
ANTHROPIC_API_KEY=

# --- Docker ---
# Réseau Docker de Nginx Proxy Manager (docker network ls)
NPM_NETWORK=npm_default
BACKUP_KEEP_DAYS=30

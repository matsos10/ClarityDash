{
  "packageId": "pt.circulofacetado.basepalmela",
  "host": "palmela.example.com",
  "name": "Base Palmela",
  "launcherName": "Palmela",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#0C0C0E",
  "themeColorDark": "#0C0C0E",
  "navigationColor": "#0C0C0E",
  "navigationColorDark": "#0C0C0E",
  "navigationDividerColor": "#0C0C0E",
  "navigationDividerColorDark": "#0C0C0E",
  "backgroundColor": "#0C0C0E",
  "enableNotifications": true,
  "startUrl": "/today",
  "iconUrl": "https://palmela.example.com/icons/icon-512.png",
  "maskableIconUrl": "https://palmela.example.com/icons/maskable-512.png",
  "monochromeIconUrl": "https://palmela.example.com/icons/badge-96.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": { "path": "./android.keystore", "alias": "palmela" },
  "appVersionName": "0.1.0",
  "appVersionCode": 1,
  "shortcuts": [
    { "name": "Capture rapide", "shortName": "Capture", "url": "/today?capture=1", "chosenIconUrl": "https://palmela.example.com/icons/icon-192.png" },
    { "name": "Nouveau trade", "shortName": "Trade", "url": "/trading/trade/new", "chosenIconUrl": "https://palmela.example.com/icons/icon-192.png" },
    { "name": "Revue du soir", "shortName": "Soir", "url": "/journal", "chosenIconUrl": "https://palmela.example.com/icons/icon-192.png" }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://palmela.example.com/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://palmela.example.com/",
  "minSdkVersion": 21,
  "orientationLock": "portrait",
  "shareTarget": {
    "action": "/api/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}

// Base Palmela — schéma Prisma (PostgreSQL)
// Conventions : ids cuid générables côté client (sync hors ligne), montants Decimal,
// dates "jour" en @db.Date (fuseau Europe/Lisbon), deletedAt = suppression douce synchronisable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════ ENUMS ═════════════════════════

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum SpaceKind {
  PERSONAL
  COUPLE
  FAMILY
}

enum SpaceRole {
  OWNER
  MEMBER
}

enum Module {
